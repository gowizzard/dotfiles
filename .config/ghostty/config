font-family = JetBrains Mono
font-size = 14
theme = jjideenschmiede
cursor-style-blink = true
mouse-hide-while-typing = true
command = /opt/homebrew/bin/herdr
keybind = cmd+shift+r=reload_config
keybind = cmd+t=text:\x02c
keybind = cmd+d=text:\x02v
keybind = cmd+shift+d=text:\x02-
keybind = cmd+shift+enter=text:\x02f
keybind = cmd+n=ignore
keybind = cmd+w=ignore
keybind = cmd+shift+w=ignore
keybind = cmd+left_bracket=ignore
keybind = cmd+right_bracket=ignore
keybind = cmd+shift+left_bracket=ignore
keybind = cmd+shift+right_bracket=ignore
keybind = cmd+1=ignore
keybind = cmd+2=ignore
keybind = cmd+3=ignore
keybind = cmd+4=ignore
keybind = cmd+5=ignore
keybind = cmd+6=ignore
keybind = cmd+7=ignore
keybind = cmd+8=ignore
keybind = cmd+9=ignore
window-padding-x = 10
window-padding-y = 10
window-height = 25
window-width = 95
window-save-state = never
resize-overlay = never
copy-on-select = true
confirm-close-surface = false
quit-after-last-window-closed = true
quick-terminal-position = center
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
auto-update = download
