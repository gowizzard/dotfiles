# This is the default .gitconfig file for my local git setup.
[user]
	email = jonas.kwiedor@jj-ideenschmiede.de
	name = Jonas Kwiedor
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICxKj59GwZAVwIZrLZYw/v+Zq9TapPixCK7fDHLbRbbd
[init]
	defaultBranch = main
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
